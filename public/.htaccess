# ForwardWeb (Astro static build) - Hostinger (LiteSpeed/Apache) config
# Served from dist/. Edit this file in public/, never in dist/.

AddDefaultCharset UTF-8
Options -Indexes

RewriteEngine On

# Force HTTPS and non-www -> canonical https://forwardweb.ca
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# --- 301s from the old site -------------------------------------------------
# Six suburb pages collapsed into two. Vaughan neighbourhoods fold into Vaughan.
RewriteRule ^web-design-maple/?$ https://forwardweb.ca/web-design-vaughan/ [R=301,L]
RewriteRule ^web-design-woodbridge/?$ https://forwardweb.ca/web-design-vaughan/ [R=301,L]
# Markham, Richmond Hill and Thornhill share the York Region page.
RewriteRule ^web-design-markham/?$ https://forwardweb.ca/web-design-york-region/ [R=301,L]
RewriteRule ^web-design-richmond-hill/?$ https://forwardweb.ca/web-design-york-region/ [R=301,L]
RewriteRule ^web-design-thornhill/?$ https://forwardweb.ca/web-design-york-region/ [R=301,L]
# Paths that moved.
RewriteRule ^portfolio/?$ https://forwardweb.ca/work/ [R=301,L]
RewriteRule ^contact/?$ https://forwardweb.ca/apply/ [R=301,L]

# The old sitemap address keeps working: serve the generated index there.
RewriteRule ^sitemap\.xml$ /sitemap-index.xml [L]

# Clean URLs: /path/ -> /path/index.html
DirectoryIndex index.html

# Gzip / Brotli compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/rss+xml image/svg+xml text/xml application/xml text/plain
</IfModule>

# Browser caching. Built assets in /_astro/ are content-hashed, so a year is safe.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

ErrorDocument 404 /404.html
