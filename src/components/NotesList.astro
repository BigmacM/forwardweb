---
import Cover from './Cover.astro';
import { fmtDate, readMinutes, type Note } from '../lib/notes';

interface Props { notes: Note[] }
const { notes } = Astro.props;
---

<div class="nlist">
  {notes.map((n) => (
    <a href={`/notes/${n.id}/`}>
      <div class="nl-cover"><Cover category={n.data.category} slug={n.id} /></div>
      <div class="nl-body">
        <small>{n.data.category}, {fmtDate(n.data.updatedAt ?? n.data.publishedAt)}, {readMinutes(n.body)} min read</small>
        <h2>{n.data.title}</h2>
        <p>{n.data.description}</p>
      </div>
    </a>
  ))}
</div>
