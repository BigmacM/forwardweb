---
import { Image } from 'astro:assets';
import portrait from '../assets/img/max/portrait.jpg';

interface Props { size: number; class?: string; eager?: boolean }
const { size, class: cls = 'avatar', eager = false } = Astro.props;
// Displayed as a round crop; the source is cropped to 3:4 and CSS centres the face.
---

<Image src={portrait} width={size * 2} height={Math.round(size * 2 * 1.333)} widths={[size * 2]} alt="" class={cls} loading={eager ? 'eager' : 'lazy'} format="webp" quality={72} />
