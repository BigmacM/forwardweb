---
import { NAV, SITE } from '../data/site';

const here = Astro.url.pathname;
const current = (href: string) => here === href || here.startsWith(href);
---

<nav class="nav" aria-label="Main">
  <a class="logo" href="/" aria-label="ForwardWeb, home">Forward<span>web</span></a>
  <ul>
    {NAV.map((l) => <li><a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
  </ul>
  <a class="call" href="/apply/">Book a call</a>
  <a class="call-sm" href="/apply/">Book a call</a>
  <details class="menu">
    <summary>Menu</summary>
    <div class="sheet">
      {NAV.map((l) => <a class="l" href={l.href}>{l.label}</a>)}
      <p>{SITE.availability}. {SITE.replyTime}</p>
      <a class="btn" href="/apply/">Book a call</a>
    </div>
  </details>
</nav>

<script>
  import '../scripts/menu';
</script>
