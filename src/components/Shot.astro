---
import { Image } from 'astro:assets';
import home from '../assets/shots/home-d.jpg';
import tour from '../assets/shots/tour-d.jpg';
import blog from '../assets/shots/blog-d.jpg';
import Annotate from './Annotate.astro';
import { AN, SHOT_ALT } from '../data/work';

interface Props { shot: 'home' | 'tour' | 'blog'; annotate?: boolean; class?: string; sizes?: string; eager?: boolean }
const { shot, annotate = false, class: cls = '', sizes = '(min-width: 860px) 50vw, 100vw', eager = false } = Astro.props;
const src = { home, tour, blog }[shot];
---

<div class={`bfr ${cls}`}>
  <div class="bt"><i></i><i></i><i></i><span>gotourniagara.ca</span></div>
  <div class="vp">
    <Image src={src} alt={SHOT_ALT[shot]} widths={[480, 720, 1080]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} format="webp" quality={78} />
    {annotate && <Annotate rings={AN[shot]} />}
  </div>
</div>
