---
---

<div class="win" data-llms>
  <div class="wbar">llms.txt generator<span class="tag">Runs in your browser</span></div>
  <div class="wbody">
    <div class="nojs-msg"><p class="readout">This generator needs JavaScript. It writes a plain markdown file from the details you type, in your browser.</p></div>
    <div class="needs-js">
      <div class="form">
        <div class="field"><label for="ll-name">Site or business name</label><input id="ll-name" data-name autocomplete="off" /></div>
        <div class="field"><label for="ll-sum">One-line summary</label><input id="ll-sum" data-sum autocomplete="off" placeholder="What you do, where, and for whom." /></div>
        <div class="field"><label for="ll-det">More detail (optional)</label><textarea id="ll-det" data-det rows="3"></textarea></div>
        <div class="field">
          <label for="ll-links">Key pages, one per line</label>
          <textarea id="ll-links" class="mono" data-links rows="6" placeholder="Services | https://yourbusiness.ca/services/ | What you offer and what it costs&#10;Contact | https://yourbusiness.ca/contact/"></textarea>
          <p class="hint">Format: Title | address | short note. The note is optional.</p>
          <div class="err" data-err role="alert"></div>
        </div>
      </div>
      <h2 class="h-m" style="margin-top:26px">Your llms.txt</h2>
      <pre class="code" data-out tabindex="0" aria-label="Generated llms.txt"></pre>
      <div class="toolbar">
        <button type="button" class="btn" data-download>Download llms.txt</button>
        <button type="button" class="linkbtn" data-copy>Copy the text</button>
        <span class="hint" data-state role="status" aria-live="polite"></span>
      </div>
      <p class="hint" style="margin-top:12px">Upload it to the root of your site so it is reachable at yourdomain.com/llms.txt. As far as I know, no major assistant has confirmed it reads the file.</p>
    </div>
  </div>
</div>

<script>
  import '../../scripts/tools/llms';
</script>
