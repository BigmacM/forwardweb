---
import { cover } from '../lib/ill';

interface Props { category: string; slug: string; tone?: 'dark' | 'light' }
const { category, slug, tone } = Astro.props;
// Two tones alternate by category, so a feed of mixed posts has rhythm.
const auto = category === 'How-to' || category === 'Test' ? 'dark' : 'light';
---

<Fragment set:html={cover(category, slug, tone ?? auto)} />
