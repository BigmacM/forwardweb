---
import Base from '../layouts/Base.astro';
---

<Base
  tone="light"
  path="/thanks/"
  title="Got it | ForwardWeb"
  description="Your message to ForwardWeb was sent. I'll reply within two working days."
  noindex
>
  <section class="light sec">
    <div class="wrap">
      <h1 class="h-xl" style="max-width:12ch">Got it.</h1>
      <p class="deck dim" style="margin:20px 0 28px;max-width:36ch">I'll reply within two working days, with a yes, a no, or a better idea.</p>
      <p style="display:flex;gap:14px;flex-wrap:wrap"><a class="btn" href="/">Back to the home page</a><a class="btn line" href="/tools/">Try a free tool</a></p>
    </div>
  </section>
</Base>
